from collections import deque

def simulate(arrival_times, stair_len):
    if not arrival_times:
        return 0

    arrival_times.sort()
    q = deque()

    time = 0
    for arrive in arrival_times:
        time = max(time, arrive)

        if len(q) == 3:
            time = q.popleft()

        q.append(time + stair_len)

    return max(q)



testcase = int(input())
for tc in range(1, testcase + 1):
    n = int(input())
    grid = [list(map(int, input().split())) for _ in range(n)]

    people = []
    stairs = []

    for i in range(n):
        for j in range(n):
            if grid[i][j] == 1:
                people.append((i, j))
            elif grid[i][j] > 1:
                stairs.append((i, j, grid[i][j]))

    P = len(people)

    dist = [[0]*2 for _ in range(P)]
    for i in range(P):
        for s in range(2):
            dist[i][s] = abs(people[i][0] - stairs[s][0]) + abs(people[i][1] - stairs[s][1])

    answer = float('inf')

    for mask in range(1 << P):
        stair0 = []
        stair1 = []

        for i in range(P):
            if mask & (1 << i):
                stair1.append(dist[i][1] + 1)
            else:
                stair0.append(dist[i][0] + 1)

        time0 = simulate(stair0, stairs[0][2])
        time1 = simulate(stair1, stairs[1][2])

        answer = min(answer, max(time0, time1))

    print(f"#{tc} {answer}")
